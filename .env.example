# ──────────────────────────────────────────────────────────────
# RimeTrack — Environment Configuration Template
# ──────────────────────────────────────────────────────────────
#
# Copy this file to .env and replace all placeholder values with
# your actual API keys and configuration.
#
# IMPORTANT: Never commit the .env file with real secrets.
#            Only .env.example (this file) should be in version control.
#
# Run `python preflight_check.py` after populating .env to verify
# all required variables are set and correctly formatted.
# ──────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════
# LIVEKIT CLOUD — WebRTC Transport & Room Infrastructure
# ═══════════════════════════════════════════════════════════════
# Your LiveKit Cloud project URL (WebSocket endpoint).
# Format: wss://<project-slug>.livekit.cloud
LIVEKIT_URL=wss://your-project.livekit.cloud

# LiveKit API credentials (from https://cloud.livekit.io → Settings → Keys).
# API Key always starts with "API" prefix.
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxxxx

# API Secret — used to sign participant JWTs. Keep this private.
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ═══════════════════════════════════════════════════════════════
# RIME LABS — Primary Spoken-Output Provider (REQUIRED)
# ═══════════════════════════════════════════════════════════════
# Rime API key (from https://rime.ai → Dashboard → API Keys).
RIME_API_KEY=your_rime_api_key_here

# Organizer-specified TTS model for conversational voice agents.
# Do NOT change unless instructed by the hackathon organizers.
RIME_MODEL=coda

# Organizer-specified speaker for clear, articulate enunciation.
# Do NOT change unless instructed by the hackathon organizers.
RIME_SPEAKER=astra

# Language code for synthesis.
RIME_LANG=eng

# Playback speed multiplier (1.0 = natural speed).
# Values < 1.0 slow down; values > 1.0 speed up.
RIME_SPEED_ALPHA=1.0

# ═══════════════════════════════════════════════════════════════
# SPEECH-TO-TEXT (STT) PROVIDER
# ═══════════════════════════════════════════════════════════════
# Deepgram Nova-3 is the primary STT provider.
# If not provided, RimeTrack falls back to OpenAI Whisper.
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ═══════════════════════════════════════════════════════════════
# LLM PROVIDER — Language Model
# ═══════════════════════════════════════════════════════════════
# OpenAI API key for GPT-4o-mini (primary LLM).
# Format: starts with "sk-" (e.g., sk-proj-...)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════════════════════════════
# LOGGING & DIAGNOSTICS
# ═══════════════════════════════════════════════════════════════
# Directory for benchmark results, trial CSVs, and event logs.
RIMETRACK_LOG_DIR=eval/results

# Log verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
RIMETRACK_LOG_LEVEL=INFO
